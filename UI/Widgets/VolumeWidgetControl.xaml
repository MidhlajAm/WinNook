<UserControl x:Class="Project_Nook.UI.Widgets.VolumeWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="64"
             PreviewMouseWheel="Tile_PreviewMouseWheel"
             Foreground="White">

    <Button Style="{StaticResource WidgetTileStyle}" Focusable="False"
            Command="{Binding ToggleMuteCommand}"
            ToolTip="Click to mute, scroll to change volume">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,3" />

            <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource WidgetTileCaptionStyle}">
                        <Style.Triggers>
                            <!-- Muted still shows the level, dimmed, so unmuting holds no surprise. -->
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Button>
</UserControl>
