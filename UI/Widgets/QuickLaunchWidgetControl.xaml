<UserControl x:Class="Project_Nook.UI.Widgets.QuickLaunchWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="200"
             Foreground="White">

    <!-- One registry slot, N tiles: pinned apps render as a group inside the rail. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,16,0">
                        <Button Style="{StaticResource WidgetTileStyle}" Focusable="False"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Name}">
                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>

                        <Button x:Name="UnpinBadge" Width="16" Height="16" Padding="0" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                Visibility="Collapsed" Cursor="Hand" ToolTip="Unpin"
                                Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E53935" CornerRadius="8">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="8" Foreground="White" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <DataTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="UnpinBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource WidgetTileStyle}" Focusable="False"
                Command="{Binding OpenSettingsCommand}" ToolTip="Choose apps to pin"
                Visibility="{Binding CanPinMore, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="#AAA" />
        </Button>
    </StackPanel>
</UserControl>
