<UserControl x:Class="Project_Nook.UI.Widgets.CalendarWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="64"
             Foreground="White">

    <!-- No action, but it stays hit-testable so the click is swallowed rather than collapsing the notch. -->
    <Button Style="{StaticResource WidgetTileStyle}" Focusable="False" Cursor="Arrow"
            ToolTip="{Binding DayOfWeek}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Month, FallbackValue='AUG'}"
                       Style="{StaticResource WidgetTileCaptionStyle}"
                       Foreground="#E53935" Margin="0,0,0,2" />
            <TextBlock Text="{Binding DayNumber, FallbackValue='16'}"
                       Style="{StaticResource WidgetTileValueStyle}"
                       FontSize="26" LineHeight="26" />
        </StackPanel>
    </Button>
</UserControl>
