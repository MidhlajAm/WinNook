<UserControl x:Class="Project_Nook.UI.Widgets.NotesPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="700"
             Foreground="White">

    <Grid Margin="16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Back. PreviewMouseLeftButtonDown so it fires before the notch sees the click and collapses. -->
        <Border Grid.Column="0" Background="Transparent" Margin="0,0,16,0" VerticalAlignment="Center" Padding="8"
                Cursor="Hand" PreviewMouseLeftButtonDown="BackButton_PreviewMouseLeftButtonDown">
            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="20" Foreground="White" />
        </Border>

        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="12" Padding="10,6">
            <Grid>
                <TextBox x:Name="NoteEditor"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="White"
                         CaretBrush="White" SelectionBrush="#556699"
                         FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         PreviewMouseLeftButtonDown="NoteEditor_PreviewMouseLeftButtonDown" />

                <TextBlock Text="Jot something down. It saves itself."
                           Foreground="#66FFFFFF" FontSize="12" IsHitTestVisible="False"
                           VerticalAlignment="Top" Margin="2,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand"
                Command="{Binding ClearCommand}" ToolTip="Clear the note">
            <ui:SymbolIcon Symbol="Eraser24" FontSize="16" Foreground="#AAA" />
        </Button>
    </Grid>
</UserControl>
