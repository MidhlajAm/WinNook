<UserControl x:Class="Project_Nook.UI.Widgets.ClipboardPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="700"
             Foreground="White">

    <Grid Margin="16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="Transparent" Margin="0,0,16,0" VerticalAlignment="Center" Padding="8"
                Cursor="Hand" PreviewMouseLeftButtonDown="BackButton_PreviewMouseLeftButtonDown">
            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="20" Foreground="White" />
        </Border>

        <ScrollViewer Grid.Column="1" x:Name="HistoryScrollViewer"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="HistoryScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,12,0">
                            <Button Width="120" Height="60" Padding="8,6" Cursor="Hand"
                                    Command="{Binding DataContext.CopyBackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Content}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WidgetTileStyle}">
                                        <Setter Property="Width" Value="120" />
                                        <Setter Property="Height" Value="60" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Content}" Foreground="#E0E0E0" FontSize="10"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                            </Button>

                            <!-- Delete badge, same affordance the Shelf uses. -->
                            <Button x:Name="DeleteBadge" Width="16" Height="16" Padding="0" BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                    Visibility="Collapsed" Cursor="Hand" ToolTip="Remove"
                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#E53935" CornerRadius="8">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="8" Foreground="White" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="20" Foreground="#66FFFFFF" Margin="0,0,8,0" />
            <TextBlock Text="Nothing copied yet. Anything you copy shows up here."
                       Foreground="#66FFFFFF" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand"
                Command="{Binding ClearAllCommand}" ToolTip="Clear history">
            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#AAA" />
        </Button>
    </Grid>
</UserControl>
