<UserControl x:Class="Project_Nook.UI.Widgets.MusicWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Project_Nook.UI.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="300" d:DesignHeight="80"
             Foreground="White">
    <UserControl.Resources>
        <!-- Converter for Play/Pause Icon -->
        <Style x:Key="PlayPauseIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Play24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Symbol" Value="Pause24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Album Art -->
        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
            <Border.Background>
                <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
            </Border.Background>
            <!-- Fallback Icon if no album art -->
            <TextBlock Text="🎵" FontSize="24" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AlbumArt}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Title, Artist & Controls -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="150">
            <controls:MarqueeTextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="White" MaxWidth="140" Margin="0,0,0,2" />
            <controls:MarqueeTextBlock Text="{Binding Artist}" FontSize="12" Foreground="#AAA" MaxWidth="140" Margin="0,0,0,8" />
            
            <StackPanel Orientation="Horizontal">
                <!-- Previous -->
                <Button Command="{Binding PreviousCommand}" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,8,0" Cursor="Hand">
                    <ui:SymbolIcon Symbol="Previous24" Filled="True" FontSize="16" Foreground="White" />
                </Button>
                <!-- Play/Pause -->
                <Button Command="{Binding PlayPauseCommand}" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,8,0" Cursor="Hand">
                    <ui:SymbolIcon Style="{StaticResource PlayPauseIconStyle}" Filled="True" FontSize="20" Foreground="White" />
                </Button>
                <!-- Next -->
                <Button Command="{Binding NextCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                    <ui:SymbolIcon Symbol="Next24" Filled="True" FontSize="16" Foreground="White" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
