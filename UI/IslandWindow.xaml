<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Project_Nook.UI.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Project_Nook.UI"
    xmlns:local_ui="clr-namespace:Project_Nook.UI"
    xmlns:widgets="clr-namespace:Project_Nook.UI.Widgets"
    xmlns:controls="clr-namespace:Project_Nook.UI.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WinNook Island"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="{x:Null}"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Left="0" Top="0"
    Height="300">

    <Window.Resources>
        <local_conv:DoubleToBottomCornerRadiusConverter x:Key="RadiusConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:StringToBrushConverter x:Key="BrushConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:StringToColorConverter x:Key="ColorConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:FilletRadiusToPathConverter x:Key="FilletPathConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:FilletRadiusToMarginConverter x:Key="FilletMarginConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:DoubleToTopMarginConverter x:Key="TopMarginConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Deliberately NOT UseLayoutRounding: this grid is centred and its child's width is spring
         animated through fractional values, so per-frame rounding makes the centred offset flip between
         whole pixels and the notch visibly shifts left and right as it settles. The fillet seam this was
         meant to solve is handled by overlapping the fillets instead (FilletRadiusToMarginConverter). -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.IsHidden}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ViewModel.IsIslandEnabled}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- The notch and its fillets share this layer so the top offset moves all three together.
             Offset 0 sits flush against the screen edge (the fillets blend it in); a positive offset
             detaches it into a floating pill, which is the Dynamic Island look. -->
        <Grid x:Name="NotchLayer" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="{Binding ViewModel.TopOffset, Converter={StaticResource TopMarginConverter}}">
        <Border x:Name="NotchBorder"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                MouseEnter="NotchBorder_MouseEnter"
                MouseLeave="NotchBorder_MouseLeave"
                MouseLeftButtonDown="NotchBorder_MouseLeftButtonDown"
                AllowDrop="True"
                DragEnter="NotchBorder_DragEnter"
                DragLeave="NotchBorder_DragLeave"
                Drop="NotchBorder_Drop">
            <Border.Background>
                <!-- Colour is driven by the palette spring in code-behind, so a hover blend can be
                     interrupted and reversed mid-flight. See IslandWindow.ApplyPaletteMix. -->
                <SolidColorBrush x:Name="NotchBackground" Color="Black" />
            </Border.Background>
            <Border.Effect>
                <!-- Direction 270 is straight down. The notch is anchored to the top screen edge, so a
                     diagonal offset threw the shadow sideways off an edge that has nothing behind it. -->
                <DropShadowEffect x:Name="NotchShadow"
                                  BlurRadius="{Binding ViewModel.ShadowBlurRadius, Mode=OneWay}"
                                  ShadowDepth="{Binding ViewModel.ShadowDepth, Mode=OneWay}"
                                  Direction="270"
                                  Opacity="{Binding ViewModel.ShadowOpacity, Mode=OneWay}"
                                  RenderingBias="Quality"
                                  Color="Black" />
            </Border.Effect>
            <!-- Clipped in code to a rect with rounded bottom corners. Border.ClipToBounds only clips to
                 the layout rectangle, so without this the expanded content (album art, widget tiles)
                 renders straight through the curve of the bottom corners. -->
            <Grid x:Name="NotchContentHost">
                <!-- Idle/Hover Content -->
                <Grid x:Name="IdleContentGrid" Margin="12,0" VerticalAlignment="Center">
                    <!-- Text Layout (Default) -->
                    <StackPanel x:Name="StateTextContainer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ViewModel.MusicWidget.IsPlaying}" Value="True" />
                                            <Condition Binding="{Binding ViewModel.IsMusicWidgetEnabled}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Foreground="White" Margin="0,0,8,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="{Binding ViewModel.TriggerIcon}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.TriggerIcon}" Value="Empty">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="{Binding ViewModel.DisplayText}" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Media Layout -->
                    <Grid x:Name="MediaLayout">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ViewModel.MusicWidget.IsPlaying}" Value="True" />
                                            <Condition Binding="{Binding ViewModel.IsMusicWidgetEnabled}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding ViewModel.MusicWidget.AlbumArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        
                        <!-- Spectrograph -->
                        <controls:SpectrographControl Grid.Column="2" IsPlaying="{Binding ViewModel.MusicWidget.IsPlaying}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
                
                <!-- Expanded Content (Dashboard or Shelf) -->
                <!-- Pinned to the final expanded width so the dashboard lays out once and is then revealed by
                     the growing border, instead of re-measuring every frame. Without this the marquee text
                     blocks re-run their overflow maths ~60 times a second during an expand. -->
                <Grid x:Name="ExpandedContentGrid" Visibility="Collapsed" Margin="0,8,0,0"
                      Width="{Binding ViewModel.ExpandedWidth, Mode=OneWay}"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedContentScale" ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <!-- Pages. Only one is visible at a time, selected by ViewModel.CurrentPage. -->
                    <ContentControl x:Name="DashboardView" DataContext="{Binding ViewModel.DashboardViewModel}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ViewModel.CurrentPage}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <widgets:WidgetDashboardControl />
                    </ContentControl>

                    <ContentControl x:Name="ShelfView">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.CurrentPage}" Value="Shelf">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <local_ui:ShelfControl />
                    </ContentControl>

                    <ContentControl x:Name="NotesView">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.CurrentPage}" Value="Notes">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <widgets:NotesPageControl />
                    </ContentControl>

                    <ContentControl x:Name="ClipboardView">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.CurrentPage}" Value="Clipboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <widgets:ClipboardPageControl />
                    </ContentControl>
                </Grid>
            </Grid>
        </Border>

        <!-- Left Fillet -->
        <Path Data="{Binding AnimatableFilletRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FilletPathConverter}, ConverterParameter=Left}"
              Fill="{Binding Background, ElementName=NotchBorder}"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="{Binding AnimatableFilletRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FilletMarginConverter}, ConverterParameter=Left}"
              Visibility="{Binding ViewModel.EnableFillets, Converter={StaticResource BoolToVis}}" />
              
        <!-- Right Fillet -->
        <Path Data="{Binding AnimatableFilletRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FilletPathConverter}, ConverterParameter=Right}"
              Fill="{Binding Background, ElementName=NotchBorder}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="{Binding AnimatableFilletRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FilletMarginConverter}, ConverterParameter=Right}"
              Visibility="{Binding ViewModel.EnableFillets, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
