<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Project_Nook.UI.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Project_Nook.UI"
    xmlns:local_ui="clr-namespace:Project_Nook.UI"
    Title="WinNook Island"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="{x:Null}"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Left="0" Top="0"
    Height="300">

    <Window.Resources>
        <local_conv:DoubleToBottomCornerRadiusConverter x:Key="RadiusConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:StringToBrushConverter x:Key="BrushConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <local_conv:StringToColorConverter x:Key="ColorConverter" xmlns:local_conv="clr-namespace:Project_Nook.Converters"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="NotchBorder"
            Visibility="{Binding ViewModel.IsIslandEnabled, Converter={StaticResource BoolToVis}}"
            Background="{Binding ViewModel.NotchColor, Converter={StaticResource BrushConverter}, Mode=OneWay}"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="{Binding ViewModel.IdleWidth, Mode=OneWay}"
            Height="{Binding ViewModel.IdleHeight, Mode=OneWay}"
            CornerRadius="{Binding ViewModel.CornerRadius, Converter={StaticResource RadiusConverter}, Mode=OneWay}"
            MouseEnter="NotchBorder_MouseEnter"
            MouseLeave="NotchBorder_MouseLeave"
            MouseLeftButtonDown="NotchBorder_MouseLeftButtonDown"
            AllowDrop="True"
            DragEnter="NotchBorder_DragEnter"
            DragLeave="NotchBorder_DragLeave"
            Drop="NotchBorder_Drop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="{Binding ViewModel.ShadowBlurRadius, Mode=OneWay}" 
                              ShadowDepth="5" 
                              Opacity="{Binding ViewModel.ShadowOpacity, Mode=OneWay}" 
                              Color="{Binding ViewModel.ShadowColor, Converter={StaticResource ColorConverter}, Mode=OneWay}" />
        </Border.Effect>
        <Grid>
            <!-- Idle/Hover Content -->
            <TextBlock x:Name="StateText" Text="11:50 🔋" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />
            
            <!-- Shelf Content (Visible when expanded) -->
            <local_ui:ShelfControl x:Name="ShelfView" Visibility="Collapsed" Margin="0,40,0,0" />
        </Grid>
    </Border>
</Window>
