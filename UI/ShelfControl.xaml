<UserControl x:Class="Project_Nook.UI.ShelfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Project_Nook.Converters"
             Foreground="White">
    <UserControl.Resources>
        <converters:TypeToIconConverter x:Key="TypeToIconConverter" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ui:Button Grid.Column="0" Appearance="Transparent" Command="{Binding CloseShelfCommand}" Margin="0,0,12,0" Padding="4">
                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="20" Foreground="White" />
            </ui:Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Library24" FontSize="20" Margin="0,0,8,0" />
                <TextBlock Text="Shelf" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1AFFFFFF" CornerRadius="8" Margin="0,4" Padding="8"
                            MouseMove="Border_MouseMove" MouseLeftButtonDown="Border_MouseLeftButtonDown"
                            Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ui:SymbolIcon Symbol="{Binding Type, Converter={StaticResource TypeToIconConverter}}" FontSize="24" Margin="0,0,12,0" />
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OriginalName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#AAFFFFFF" />
                            </StackPanel>
                            
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Open24}" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0" Appearance="Transparent" />
                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0" Appearance="Danger" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
