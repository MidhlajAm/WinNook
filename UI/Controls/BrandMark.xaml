<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The WinNook mark, as vector geometry rather than a bitmap.

        Transcribed from Assets/winnook-icon.svg on the same 256 grid, so the two stay in step: four
        panes for the desktop, the dark island band across them, and the narrow highlight pane that
        breaks the 2x2 grid so the mark does not read as the Windows logo.

        Vector because this is drawn at anything from 20px in a header to 96px on the about card, and
        the .ico only carries fixed sizes. The island is #16181D, never pure black - flattening it to
        black loses the band against a dark window chrome.
    -->

    <Color x:Key="BrandAccentColor">#0078D4</Color>
    <Color x:Key="BrandHighlightColor">#4CC2FF</Color>
    <Color x:Key="BrandIslandColor">#16181D</Color>

    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandHighlightBrush" Color="{StaticResource BrandHighlightColor}" />

    <DrawingImage x:Key="WinNookMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Locks the drawing to the full 256 grid so the artwork keeps its intended padding
                     instead of the bounds collapsing onto the painted shapes. -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Panes -->
                <GeometryDrawing Brush="#0078D4">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="28,26,88,76" RadiusX="16" RadiusY="16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0078D4">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="140,26,88,76" RadiusX="16" RadiusY="16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0078D4">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="28,154,132,76" RadiusX="16" RadiusY="16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#4CC2FF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="184,154,44,76" RadiusX="16" RadiusY="16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- The island: radius 24 on a 48 band, so it stays a true pill. -->
                <GeometryDrawing Brush="#16181D">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="24,104,208,48" RadiusX="24" RadiusY="24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Status dot and content bar inside the island. -->
                <GeometryDrawing Brush="#4CC2FF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="58,128" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="86,120,72,16" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Wordmark styling, so "WinNook" is set the same way wherever it appears beside the mark. -->
    <Style x:Key="BrandWordmark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BrandWordmarkAccent" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource BrandHighlightBrush}" />
    </Style>

</ResourceDictionary>
