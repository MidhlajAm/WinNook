<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared vocabulary for the Control Center.

        Every settings row used to hand-roll its own Border with its own padding and margin, so the same
        visual element came in four slightly different sizes depending on which tab it was written on.
        These styles are the single definition; the rhythm below is what keeps the tabs feeling related.

            card gap        12
            section gap     28
            card padding    16,12
    -->

    <!-- One settings row: label and description on the left, control on the right. -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Heading above a group of cards. Left aligned: centred headings over left-aligned rows made the
         eye jump back and forth down the page. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- Sub-heading inside a section, e.g. "Idle State". -->
    <Style x:Key="SubSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#8A8A8A" />
        <Setter Property="Margin" Value="2,16,0,8" />
    </Style>

    <!-- The sentence under a heading explaining what the section is for. -->
    <Style x:Key="SectionCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#8A8A8A" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2,0,0,16" />
    </Style>

    <Style x:Key="SettingLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SettingDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#8A8A8A" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Right-aligned numeric readout beside a slider. Tabular figures and a fixed width stop the number
         shifting the slider as it counts up through 9, 10, 100. -->
    <Style x:Key="SettingValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8A8A8A" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="44" />
        <!-- Left margin separates the number from the slider; the right margin keeps it clear of the
             scroll bar, which was slicing the last digit off values like "20" and "100". -->
        <Setter Property="Margin" Value="12,0,4,0" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
    </Style>

</ResourceDictionary>
