<UserControl x:Class="Project_Nook.UI.Controls.SpectrographControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="24">
    <UserControl.Resources>
        <Storyboard x:Key="SpectrographAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height" From="4" To="14" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height" From="6" To="18" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height" From="3" To="12" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height" From="5" To="16" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="20">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle x:Name="Bar1" Width="3" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" />
            <Rectangle x:Name="Bar2" Width="3" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" />
            <Rectangle x:Name="Bar3" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Center" />
            <Rectangle x:Name="Bar4" Width="3" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
