<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="Project_Nook.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WinNook"
    Height="650" Width="800"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="WinNook Control Center" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,32">
                <TextBlock Text="{Binding ViewModel.Greeting, Mode=OneWay}" FontSize="24" HorizontalAlignment="Center"/>
            
            <ui:Button Command="{Binding ViewModel.UpdateGreetingCommand}"
                       HorizontalAlignment="Center"
                       Icon="{ui:SymbolIcon Edit24}"
                       Content="Update Greeting"
                       Margin="0,16,0,0"
                       Padding="24,12" />
            
            <TextBlock Text="Live Preview Control" FontSize="18" FontWeight="SemiBold" Margin="0,32,0,0" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <ui:Button Content="Hover" Command="{Binding ViewModel.HoverIslandCommand}" Margin="4" />
                <ui:Button Content="Idle" Command="{Binding ViewModel.UnhoverIslandCommand}" Margin="4" />
                <ui:Button Content="Expand" Command="{Binding ViewModel.ExpandIslandCommand}" Margin="4" />
                <ui:Button Content="Collapse" Command="{Binding ViewModel.CollapseIslandCommand}" Margin="4" />
            </StackPanel>

            <!-- Visual Polish Settings -->
            <TextBlock Text="Visual Polish Settings" FontSize="18" FontWeight="SemiBold" Margin="0,32,0,0" HorizontalAlignment="Center"/>
            <Grid Margin="0,16,0,32" Width="300" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Enable Notch" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ui:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ViewModel.Island.IsIslandEnabled}" Margin="0,4" />

                <TextBlock Text="Width" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="100" Maximum="500" Value="{Binding ViewModel.Island.IdleWidth}" Margin="0,4" />

                <TextBlock Text="Height" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding ViewModel.Island.IdleHeight}" Margin="0,4" />

                <TextBlock Text="Corner Radius" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding ViewModel.Island.CornerRadius}" Margin="0,4" />

                <TextBlock Text="Shadow Blur" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ViewModel.Island.ShadowBlurRadius}" Margin="0,4" />

                <TextBlock Text="Shadow Opacity" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ViewModel.Island.ShadowOpacity}" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1" Margin="0,4" />

                <TextBlock Text="Notch Color" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding ViewModel.Island.NotchColor, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Content="Pick" Click="PickNotchColor_Click" Margin="4,0,0,0" />
                </Grid>

                <TextBlock Text="Shadow Color" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Grid Grid.Row="7" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding ViewModel.Island.ShadowColor, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Content="Pick" Click="PickShadowColor_Click" Margin="4,0,0,0" />
                </Grid>

                <ui:Button Grid.Row="8" Grid.ColumnSpan="2" Content="Reset Settings" Command="{Binding ViewModel.Island.ResetSettingsCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" Appearance="Danger" />
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
