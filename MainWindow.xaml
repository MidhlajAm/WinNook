<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="Project_Nook.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WinNook"
    Height="800" Width="900"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid Background="#1E2227">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="WinNook Control Center" Grid.Row="0" Foreground="White" />

        <Border Grid.Row="1" Background="#282C34" BorderBrush="#333" BorderThickness="0,0,0,1">
            <ListBox x:Name="DockListBox" SelectedIndex="{Binding ViewModel.SelectedTabIndex}" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ClipToBounds="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Margin" Value="4,16"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,1.0"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3E4451"/>
                                        </Trigger>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                

                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Color24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Appearance" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Drop24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Effect" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="WindowApps24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Activity" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Library24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Shelf" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Options" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Person24" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Developer" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,16,0,0" HorizontalAlignment="Center" SelectedIndex="{Binding ViewModel.SelectedTabIndex}" SelectionChanged="TabControl_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            


            <!-- APPEARANCE TAB (Index 1) -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="400">
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Notch Appearance" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                            <ui:Button Content="Reset Default" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ViewModel.Island.RestoreDefaultsCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Inverted Curves" VerticalAlignment="Center" Foreground="White" />
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.Island.EnableFillets}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fillet Radius" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="40" Value="{Binding ViewModel.Island.FilletRadius, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.FilletRadius, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Idle State" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#AAA"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Width" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="100" Maximum="500" Value="{Binding ViewModel.Island.IdleWidth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.IdleWidth, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Height" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding ViewModel.Island.IdleHeight, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.IdleHeight, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Corner Radius" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding ViewModel.Island.CornerRadius, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.CornerRadius, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>


                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notch Color" VerticalAlignment="Center" Foreground="White" />
                            <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.Island.NotchColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Foreground="White" />
                            <ui:Button Grid.Column="2" Content="Pick" Click="PickNotchColor_Click" />
                        </Grid>

                        <TextBlock Text="Hover State" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,16" Foreground="#AAA"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hover Width" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="100" Maximum="600" Value="{Binding ViewModel.Island.HoverWidth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.HoverWidth, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hover Height" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="20" Maximum="200" Value="{Binding ViewModel.Island.HoverHeight, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.HoverHeight, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hover Corner Radius" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding ViewModel.Island.HoverCornerRadius, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.HoverCornerRadius, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expanded Corner Rad." VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding ViewModel.Island.ExpandedCornerRadius, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.Island.ExpandedCornerRadius, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="#AAA" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hover Color" VerticalAlignment="Center" Foreground="White" />
                            <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.Island.HoverNotchColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Foreground="White" />
                            <ui:Button Grid.Column="2" Content="Pick" Click="PickHoverNotchColor_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- EFFECTS TAB (Index 2) -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="400">
                        <TextBlock Text="Shadows &amp; Animation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" Foreground="White"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Anim Speed (ms)" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="100" Maximum="2000" Value="{Binding ViewModel.Island.AnimationSpeedMs}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shadow Blur" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ViewModel.Island.ShadowBlurRadius}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shadow Opacity" VerticalAlignment="Center" Foreground="White" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ViewModel.Island.ShadowOpacity}" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Idle Shadow" VerticalAlignment="Center" Foreground="White" />
                            <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.Island.ShadowColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Foreground="White" />
                            <ui:Button Grid.Column="2" Content="Pick" Click="PickShadowColor_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hover Shadow" VerticalAlignment="Center" Foreground="White" />
                            <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.Island.HoverShadowColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Foreground="White" />
                            <ui:Button Grid.Column="2" Content="Pick" Click="PickHoverShadowColor_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ACTIVITY TAB (Index 3) -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="400">
                        <TextBlock Text="Widget Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" Foreground="White"/>
                        
                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,32" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Music Widget" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Show media playback and controls in the Notch." Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.IsMusicWidgetEnabled}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Live Preview Control" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Manually test the states of the Notch without triggering system events." TextWrapping="Wrap" Margin="0,0,0,24" HorizontalAlignment="Center" TextAlignment="Center" Foreground="White" />
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <ui:Button Content="Hover Mode" Command="{Binding ViewModel.HoverIslandCommand}" Margin="4" HorizontalAlignment="Stretch" />
                            <ui:Button Grid.Column="1" Content="Idle Mode" Command="{Binding ViewModel.UnhoverIslandCommand}" Margin="4" HorizontalAlignment="Stretch" />
                            
                            <ui:Button Grid.Row="1" Content="Expand (Shelf)" Command="{Binding ViewModel.ExpandIslandCommand}" Margin="4" HorizontalAlignment="Stretch" />
                            <ui:Button Grid.Row="1" Grid.Column="1" Content="Collapse" Command="{Binding ViewModel.CollapseIslandCommand}" Margin="4" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SHELF TAB (Index 4) -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="400">
                        <TextBlock Text="Shelf Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="More shelf configuration options coming soon!" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- OPTIONS TAB (Index 4) -->
            <TabItem>
                <Grid Margin="16,16,16,16" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="33" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Sidebar -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OPTIONS" FontSize="12" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,16" HorizontalAlignment="Center" />
                        <ListBox SelectedIndex="{Binding ViewModel.SelectedOptionsTabIndex}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="100" />
                                    <Setter Property="Height" Value="80" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3E4451" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.Setters>
                                                <Setter Property="Background" Value="#2A2E37" />
                                            </MultiTrigger.Setters>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            
                            <ListBoxItem>
                                <StackPanel Orientation="Vertical">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="24" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="General" HorizontalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Vertical">
                                    <ui:SymbolIcon Symbol="LeafOne24" FontSize="24" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="Dive In" HorizontalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Vertical">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="24" Margin="0,0,0,8" Foreground="#ff4d4d" HorizontalAlignment="Center" />
                                    <TextBlock Text="Danger Zone" Foreground="#ff4d4d" HorizontalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                    
                    <!-- Vertical Separator -->
                    <Border Grid.Column="1" Background="#555555" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,0,16" />
                    
                    <!-- Right Content Area -->
                    <TabControl Grid.Column="2" SelectedIndex="{Binding ViewModel.SelectedOptionsTabIndex}" Background="Transparent" BorderThickness="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- General (Index 0) -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="General Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" Foreground="White"/>
                                    
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Run at Startup" Grid.Column="0" VerticalAlignment="Center" Foreground="White" Margin="0,0,16,0" />
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.IsStartupEnabled}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Enable Notch" Grid.Column="0" VerticalAlignment="Center" Foreground="White" Margin="0,0,16,0" />
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.Island.IsIslandEnabled}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Default Text" Grid.Column="0" VerticalAlignment="Center" Foreground="White" Margin="0,0,16,0" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.Island.TriggerText, UpdateSourceTrigger=PropertyChanged}" Foreground="White" Width="200" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <!-- Danger Zone (Index 1) -->
                        <!-- Dive In (Index 1) -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <TextBlock Text="Dive In" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
                                    
                                    <ListBox SelectedIndex="{Binding ViewModel.SelectedDiveInTabIndex}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="16,8" />
                                                <Setter Property="Margin" Value="0,0,8,0" />
                                                <Setter Property="Foreground" Value="#888" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#3E4451" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                            <Condition Property="IsSelected" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter Property="Background" Value="#2A2E37" />
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBoxItem Content="Dive In Mode" />
                                        <ListBoxItem Content="Dive In Settings" />
                                    </ListBox>
                                </StackPanel>

                                <TabControl Grid.Row="1" SelectedIndex="{Binding ViewModel.SelectedDiveInTabIndex}" Background="Transparent" BorderThickness="0">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                    
                                    <!-- Mode Tab -->
                                    <TabItem>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Select apps that will hide the notch automatically when focused." Foreground="#888" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:Button Grid.Column="1" Content="Refresh Apps" HorizontalAlignment="Right" Command="{Binding ViewModel.LoadInstalledAppsCommand}" VerticalAlignment="Center" />
                                            </Grid>
                                            
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ViewModel.DiveInApps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Grid.Column="0" Source="{Binding IconImage}" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ExecutableName}" Foreground="#888" FontSize="11" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsDiveInEnabled}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </TabItem>
                                    
                                    <!-- Settings Tab -->
                                    <TabItem>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="24">
                                                <TextBlock Text="Dive In settings coming soon..." Foreground="#888" HorizontalAlignment="Center" />
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>

                        <!-- Danger Zone (Index 2) -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Danger Zone" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" Foreground="#ff4d4d"/>
                                    
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Kill Nook" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="Immediately shuts down the WinNook application without confirmation." Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="Kill Nook" Command="{Binding ViewModel.KillAppCommand}" Appearance="Danger" VerticalAlignment="Center" ToolTip="Immediately forces the WinNook process to exit. Use this if the app becomes unresponsive or if you need to quickly stop it." />
                                        </Grid>
                                    </Border>
                                    
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Uninstall / Delete Nook" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="Permanently deletes WinNook, removes it from startup, and wipes all saved configurations." Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="Delete Nook" Command="{Binding ViewModel.DeleteAppCommand}" Appearance="Danger" VerticalAlignment="Center" ToolTip="Removes WinNook from startup, deletes all saved configurations and settings, and permanently deletes the executable file." />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- DEVELOPER TAB (Index 6) -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="550">
                        <TextBlock Text="About the Developer" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" HorizontalAlignment="Center" Foreground="White"/>
                        
                        <Border Background="#21252B" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#333" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Column: Avatar & Quick Links -->
                                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PersonBoard24" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#61AFEF" />
                                    <TextBlock Text="Midhlaj AM" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="Software Engineer" FontSize="14" Foreground="#ABB2BF" HorizontalAlignment="Center" Margin="0,4,0,16" />
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:Button Content="LinkedIn" Icon="ContactLink24" Margin="0,0,8,0" Click="LinkedIn_Click" />
                                        <ui:Button Content="GitHub" Icon="Code24" Click="GitHub_Click" />
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Right Column: About & Support -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="About Me" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                                    <TextBlock Text="I'm the creator of WinNook. I am a passionate developer who loves building highly polished, real-time software systems and smooth user experiences. My goal is to make Windows desktop environments feel as dynamic, responsive, and beautiful as modern mobile operating systems." 
                                               TextWrapping="Wrap" Foreground="#ABB2BF" Margin="0,0,0,24" LineHeight="20"/>
                                    
                                    <Border Height="1" Background="#333" Margin="0,0,0,24" />
                                    
                                    <TextBlock Text="Support the Project" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                                    <Button Click="OpenKofi_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="4" CornerRadius="8">
                                                    <Image Source="https://storage.ko-fi.com/cdn/kofi6.png?v=6" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
